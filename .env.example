# Copy to .env (git-ignored) and change anything you need.
# These are local practice credentials only — never reuse a real password here.

MYSQL_ROOT_PASSWORD=practice
MYSQL_PORT=3306

POSTGRES_USER=postgres
POSTGRES_PASSWORD=practice
POSTGRES_PORT=5432

# Optional pgAdmin (docker compose --profile gui up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=practice
PGADMIN_PORT=5050
